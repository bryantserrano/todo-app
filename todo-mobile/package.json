{
  "name": "todo-mobile",
  "version": "1.0.0",
  "description": "Native Todo App with Expo Router",
  "main": "expo-router/entry",
  "type": "module",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client",
