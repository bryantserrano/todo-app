{
  "expo": {
    "name": "Todo Mobile",
    "slug": "todo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bryantserrano.todomobile"
    },
    "android": {
      "package": "com.bryantserrano.todomobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": false
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a1a1a"
        }
      ]
    ],
    "scheme": "todomobile"
  }
}
